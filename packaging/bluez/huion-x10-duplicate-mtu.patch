Description: tolerate duplicate ATT requests from Huion Note X10
 The X10 firmware may send a duplicate Exchange MTU request while another
 request is pending. Dropping that duplicate keeps the BLE session alive.
Origin: https://github.com/Reginleif86/huion-note-x10-ble
Forwarded: not-needed
Last-Update: 2026-10-08

--- a/src/shared/att.c
+++ b/src/shared/att.c
@@ -1071,12 +1071,9 @@ static bool can_read_data(struct io *io,
 			 */
 			if (chan->in_req) {
 				DBG(att, "(chan %p) Received request while "
-						"another is pending: 0x%02x",
+						"another is pending: 0x%02x (dropping duplicate)",
 						chan, opcode);
-				io_shutdown(chan->io);
-				bt_att_unref(chan->att);
-
-				return false;
+				return true;
 			}
 
 			chan->in_req = true;
